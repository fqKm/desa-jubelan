# ============================================================
# Environment Variables untuk Desa Jubelan
# Salin file ini ke .env.local dan isi nilainya
# ============================================================

# ── Neon Database (PostgreSQL) ─────────────────────────────
# Didapat dari: Vercel Dashboard → Storage → Neon → Connect → .env.local
POSTGRES_URL=postgresql://neondb_owner:npg_nZ7LwGTmh6Wy@ep-green-flower-b7hfiud0-pooler.c-13.us-east-1.aws.neon.tech/desajubelan?sslmode=require&channel_binding=require

# ── Vercel Blob Storage ────────────────────────────────────
# Didapat dari: Vercel Dashboard → Storage → Blob → Connect → .env.local
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_GANTI_INI

# ── Admin Login Portal ─────────────────────────────────────
# Username dan password untuk Portal Perangkat Desa
# Ganti dengan nilai yang aman sebelum deploy!
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=jubelan2026

# ── Mode Aktif ─────────────────────────────────────────────
# Set ke true untuk menggunakan Neon DB (production)
# Set ke false atau hapus untuk mode localStorage (development)
VITE_USE_NEON=true
